							</Panel>
						</Panel>
					</Panel>
					<Panel class="ov-stats" hittest="false">
						<Panel class="st-row" hittest="false">
							<Panel class="st" hittest="false"><Label class="st-k" text="KILLS" /><Panel class="st-vrow" hittest="false"><Label class="st-v" text="{s:st_kills}" /></Panel></Panel>
							<Panel class="st" hittest="false"><Label class="st-k" text="DEATHS" /><Panel class="st-vrow" hittest="false"><Label class="st-v" text="{s:st_deaths}" /></Panel></Panel>
