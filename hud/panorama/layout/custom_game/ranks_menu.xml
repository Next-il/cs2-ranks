	<!--
		/rank (and /top, which opens it on Top players) - generated by hud/tools/gen_layouts.py. Driven by Hud/RankMenu.cs.

		CONTRACT
		  RootPanelId = "RanksMenuRoot"   RevealClass = "show"   CloseButtonId = "rm_close"   RowCount = 0
		  CaptureInput = true             SharedText = false

		BUTTONS (PanelAction.Button, by id)
		  rt_0..rt_3                       tabs: overview, top players, all ranks, settings
		  se_feed_on|off  se_mode_off|dead|always  se_pos_radar|right|bottom  se_size_s|m|l

		CLASSES THE SERVER TOGGLES
		  rt_N / pg_N      active           the tab and its page
		  rm_bar           at-0 .. at-3     the underline under the active tab
		  ov_icon, tpN_icon, tp_me_icon, arN_icon   sg-0 .. sg-23
		  ov_fill          p0 .. p50
		  ov_chip, tp_status, tpN, tp_me, arN, ar_rowN   hidden
		  tpN              me, top3         arN   cur, locked
		  ob_vip ob_name ob_wknd ob_total   on
		  se_* buttons     on               se_pos_opts, se_size_opts   disabled
		  mini_blk         pos-radar | pos-right | pos-bottom, off     mini_size   size-s | size-m | size-l
	-->
	<Panel class="hud-screen" hittest="false">
		<Panel id="RanksMenuRoot" class="hud-root hud-card rm-root">
			<Panel class="hud-head">
				<Label class="hud-title rm-title" text="RANK" />
				<Label class="hud-tag rm-tag" text="{s:rm_tag}" />
				<Panel class="fill" hittest="false" />
				<Button id="rm_close" class="hud-exit"><Label class="hud-x" text="&#x2715;" /></Button>
			</Panel>
			<Panel class="rm-tabs">
					<Button id="rt_0" class="rm-tab"><Label class="rm-tab-lbl" text="OVERVIEW" /></Button>
					<Button id="rt_1" class="rm-tab"><Label class="rm-tab-lbl" text="TOP PLAYERS" /></Button>
					<Button id="rt_2" class="rm-tab"><Label class="rm-tab-lbl" text="ALL RANKS" /></Button>
					<Button id="rt_3" class="rm-tab"><Label class="rm-tab-lbl" text="SETTINGS" /></Button>
				<Panel id="rm_bar" class="rm-bar" hittest="false" />
			</Panel>
			<Panel class="rm-body" hittest="false">

				<Panel id="pg_0" class="rm-page" hittest="false">
					<Panel class="ov-top" hittest="false">
						<Panel id="ov_icon" class="ov-icon sg" hittest="false" />
						<Panel class="ov-main" hittest="false">
							<Panel class="ov-name-row" hittest="false">
