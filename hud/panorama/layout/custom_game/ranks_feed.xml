	<!--
		XP feed and the RANK UP banner - generated by hud/tools/gen_layouts.py. Driven by Hud/XpFeed.cs.

		NOT INTERACTIVE. Open for every player from the moment they join; /xp only stops the lines.

		CONTRACT
		  RootPanelId  = "RanksFeedRoot"    RevealClass = "show"   RowCount = 0   SharedText = false

		THE TOAST MODEL. A line keeps its slot for its whole life. xf{n} loses "hidden" (into layout), a beat later
		xf{n}_row gains "show" (slides in from off screen, fades, unblurs); when it expires "show" comes off (slides back
		out) and then xf{n} gains "hidden" (collapses; the slots below glide up on their position transition).

		CLASSES THE SERVER TOGGLES
		  xf_stack         pos-right | pos-cross
		  xf{n}            hidden
		  xf{n}_row        show; plain | bonus | loss | note | rankdown; tagged; capped
		  xf{n}_<icon>     on        hs wb ns bl sm kn sk
		  ru               show      the RANK UP banner; the pop plays as it comes on
		  ru_icon          sg-0 .. sg-23

		DIALOG VARIABLES
		  xf{n}_orig xf{n}_amt xf{n}_chip xf{n}_tag xf{n}_tag2   ru_name ru_old ru_new
	-->
	<Panel class="hud-screen" hittest="false">
		<Panel id="RanksFeedRoot" class="xf-root" hittest="false">
			<Panel id="xf_stack" class="xf-stack" hittest="false">
				<Panel id="xf0" class="xf-slot hidden" hittest="false">
					<Panel id="xf0_row" class="xf-row" hittest="false">
						<Label class="xf-orig" text="{s:xf0_orig}" />
						<Label class="xf-amt" text="{s:xf0_amt}" />
						<Label class="xf-unit" text="XP" />
						<Panel class="xf-chip" hittest="false">
							<Label class="xf-chip-v" text="{s:xf0_chip}" />
							<Label class="xf-chip-max" text="MAX" />
						</Panel>
						<Label class="xf-tag" text="{s:xf0_tag}" />
						<Label class="xf-tag2" text="{s:xf0_tag2}" />
						<Panel class="xf-ics" hittest="false">
						<Panel id="xf0_hs" class="xf-ic ic-hs" hittest="false" />
						<Panel id="xf0_wb" class="xf-ic ic-wb" hittest="false" />
						<Panel id="xf0_ns" class="xf-ic ic-ns" hittest="false" />
