<root>
	<styles>
		<include src="s2r://panorama/styles/custom_game/hud_shared.vcss_c" />
		<include src="s2r://panorama/styles/custom_game/ranks_shared.vcss_c" />
		<include src="s2r://panorama/styles/custom_game/ranks_panel.vcss_c" />
	</styles>

	<!--
		Rank panel - generated by hud/tools/gen_layouts.py. Driven by Hud/RankPanel.cs.

		NOT INTERACTIVE: hittest false everywhere, CaptureInput = false. Shown while the player is dead, or always.

		CONTRACT
		  RootPanelId  = "RanksPanelRoot"   RevealClass = "show"   RowCount = 0   SharedText = false

		CLASSES THE SERVER TOGGLES
		  RanksPanelRoot   pos-radar | pos-right | pos-bottom   where it sits and the edge it slides in from
		  RanksPanelRoot   maxed                                 top rank: no next icon, the next label goes gold
		  rp_scale         size-s | size-m | size-l              ui-scale 85% / 100% / 120%
		  rp_icon_cur      sg-0 .. sg-23, swap-a | swap-b        rank art; the swap pair restarts the rank-up flash
		  rp_icon_next     sg-0 .. sg-23
		  rp_fill          p0 .. p50                             progress to the next rank, 2% a step
		  rp_b_vip / rp_b_name / rp_b_wknd   on                  that bonus is active
		  rp_total         on                                    any bonus active (gold total)
		  rp_total_max     hidden                                off when the total hit the cap

		DIALOG VARIABLES
		  rp_cur rp_next rp_xp_now rp_xp_need rp_total rp_vip rp_vip_hint rp_name rp_name_hint
		  rp_wknd rp_wknd_label rp_wknd_hint rp_foot
	-->
	<Panel class="hud-screen" hittest="false">
		<Panel id="RanksPanelRoot" class="rp-root" hittest="false">
			<Panel id="rp_scale" class="rp-scale" hittest="false">
				<Panel class="rp-card hud-card" hittest="false">
					<Label class="rp-eyebrow rp-title" text="RANK" />
					<Panel class="rp-ranks" hittest="false">
						<Panel class="rp-rank rp-rank-cur" hittest="false">
							<Panel id="rp_icon_cur" class="rp-icon sg" hittest="false" />
							<Label class="rp-rname" text="{s:rp_cur}" />
						</Panel>
						<Panel class="fill" hittest="false" />
						<Panel class="rp-rank rp-rank-next" hittest="false">
							<Label class="rp-rname" text="{s:rp_next}" />
							<Panel id="rp_icon_next" class="rp-icon sg" hittest="false" />
						</Panel>
					</Panel>
					<Panel class="rp-bar" hittest="false">
						<Panel class="segs segs-track" hittest="false"><Panel class="seg" hittest="false" /><Panel class="seg" hittest="false" /><Panel class="seg" hittest="false" /><Panel class="seg" hittest="false" /><Panel class="seg" hittest="false" /><Panel class="seg" hittest="false" /><Panel class="seg" hittest="false" /><Panel class="seg" hittest="false" /><Panel class="seg" hittest="false" /><Panel class="seg" hittest="false" /><Panel class="seg" hittest="false" /><Panel class="seg" hittest="false" /><Panel class="seg" hittest="false" /><Panel class="seg" hittest="false" /><Panel class="seg" hittest="false" /><Panel class="seg" hittest="false" /><Panel class="seg" hittest="false" /><Panel class="seg" hittest="false" /><Panel class="seg" hittest="false" /><Panel class="seg" hittest="false" /></Panel>
						<Panel id="rp_fill" class="segs segs-fill" hittest="false"><Panel class="seg" hittest="false" /><Panel class="seg" hittest="false" /><Panel class="seg" hittest="false" /><Panel class="seg" hittest="false" /><Panel class="seg" hittest="false" /><Panel class="seg" hittest="false" /><Panel class="seg" hittest="false" /><Panel class="seg" hittest="false" /><Panel class="seg" hittest="false" /><Panel class="seg" hittest="false" /><Panel class="seg" hittest="false" /><Panel class="seg" hittest="false" /><Panel class="seg" hittest="false" /><Panel class="seg" hittest="false" /><Panel class="seg" hittest="false" /><Panel class="seg" hittest="false" /><Panel class="seg" hittest="false" /><Panel class="seg" hittest="false" /><Panel class="seg" hittest="false" /><Panel class="seg" hittest="false" /></Panel>
					</Panel>
					<Panel class="rp-xp" hittest="false">
						<Label class="rp-xp-now" text="{s:rp_xp_now}" />
						<Label class="rp-xp-need" text="{s:rp_xp_need}" />
					</Panel>
					<Panel class="rp-sep" hittest="false" />
					<Panel class="rp-bonus" hittest="false">
						<Panel class="rp-bonus-head" hittest="false">
							<Label class="rp-eyebrow" text="ACTIVE XP BONUSES" />
							<Panel class="fill" hittest="false" />
							<Panel id="rp_total" class="rp-total" hittest="false">
								<Label class="rp-total-v" text="{s:rp_total}" />
								<Label id="rp_total_max" class="rp-max hidden" text="MAX" />
							</Panel>
						</Panel>
						<Panel id="rp_b_vip" class="rp-b" hittest="false">
							<Panel class="rp-dot" hittest="false" />
							<Label class="rp-b-name" text="VIP" />
							<Label class="rp-b-hint" text="{s:rp_vip_hint}" />
							<Panel class="fill" hittest="false" />
							<Label class="rp-b-val" text="{s:rp_vip}" />
						</Panel>
						<Panel id="rp_b_name" class="rp-b" hittest="false">
							<Panel class="rp-dot" hittest="false" />
							<Label class="rp-b-name" text="Name reward" />
							<Label class="rp-b-hint" text="{s:rp_name_hint}" />
							<Panel class="fill" hittest="false" />
							<Label class="rp-b-val" text="{s:rp_name}" />
						</Panel>
						<Panel id="rp_b_boost" class="rp-b" hittest="false">
							<Panel class="rp-dot" hittest="false" />
							<Label class="rp-b-name" text="XP booster" />
							<Panel class="fill" hittest="false" />
							<Label class="rp-soon" text="COMING SOON" />
						</Panel>
						<Panel id="rp_b_wknd" class="rp-b" hittest="false">
							<Panel class="rp-dot" hittest="false" />
							<Label class="rp-b-name" text="{s:rp_wknd_label}" />
							<Label class="rp-b-hint" text="{s:rp_wknd_hint}" />
							<Panel class="fill" hittest="false" />
							<Label class="rp-b-val" text="{s:rp_wknd}" />
						</Panel>
					</Panel>
					<Panel class="rp-sep" hittest="false" />
					<Panel class="rp-foot" hittest="false">
						<Label class="rp-cmd" text="/xp" />
						<Label class="rp-foot-txt" text="{s:rp_foot}" />
					</Panel>
				</Panel>
			</Panel>
		</Panel>
	</Panel>
</root>
